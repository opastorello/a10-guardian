# A10 Device Credentials
A10_USERNAME=your_username
A10_PASSWORD=your_password
A10_BASE_URL=https://your-a10-host:17489
A10_VERIFY_SSL=False

# --- TOKENS ---
# Uso interno (equipe) — acesso total a todos os endpoints
# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
API_SECRET_TOKEN=your_internal_master_token_here

# MCP server — acesso total, token dedicado para clientes MCP (Claude, etc.)
# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
MCP_SECRET_TOKEN=your_mcp_token_here

# Tokens adicionais com scopes granulares (JSON)
# Scopes disponíveis: system:read, mitigation:read, mitigation:write, templates:read, templates:write, attacks:read
# Exemplo — token só leitura para site externo (under-attack, list zones, zone status):
API_TOKENS={"tok_site_exemplo": ["mitigation:read"]}
# Exemplo — múltiplos tokens:
# API_TOKENS={"tok_readonly": ["mitigation:read", "system:read"], "tok_ops": ["mitigation:read", "mitigation:write"]}

# CORS — origens permitidas (vazio = bloqueia cross-origin)
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# App Settings
DEBUG=False
LOG_LEVEL=INFO
RATE_LIMIT_DEFAULT=60/minute

# Template Configuration
TEMPLATE_DIR=config/zone_templates

# Notifications (Discord/Slack/Teams webhook)
WEBHOOK_ENABLED=False
# Single webhook:
WEBHOOK_URL=https://your-webhook-url-here
# Or multiple webhooks (comma-separated):
# WEBHOOK_URL=https://discord-webhook-1,https://discord-webhook-2,https://slack-webhook
WEBHOOK_USERNAME=A10 Guardian
WEBHOOK_FOOTER=A10 Guardian API

# Telegram Notifications (optional, works alongside webhooks)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Notification Granular Control (requires WEBHOOK_ENABLED=True)
NOTIFY_TEMPLATE_CREATE=True
NOTIFY_TEMPLATE_UPDATE=False
NOTIFY_TEMPLATE_DELETE=True
NOTIFY_TEMPLATE_IMPORT=True
NOTIFY_MITIGATION_START=True
NOTIFY_MITIGATION_STOP=True
NOTIFY_SYSTEM_HEALTH=False

# Attack Monitoring (real-time DDoS attack detection)
NOTIFY_ATTACK_DETECTED=True
NOTIFY_ATTACK_MITIGATED=True
NOTIFY_ATTACK_ONGOING=False
ATTACK_MONITORING_INTERVAL=30

# Zone Change Monitoring (detect external zone changes)
NOTIFY_ZONE_CREATED=True
NOTIFY_ZONE_MODIFIED=True
NOTIFY_ZONE_DELETED=True
ZONE_MONITORING_INTERVAL=30
